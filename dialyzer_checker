#!/usr/bin/env python3

import re
import sys
from pathlib import Path


def check_warnings():
    report = Path('dialyzer_warnings')
    known = Path(__file__).with_name('known_dialyzer_warnings')
    with known.open(encoding='utf-8') as entries:
        patterns = [re.compile(entry) for entry in map(str.strip, entries) if entry]

    saw_warning = False
    unexpected = False
    with report.open(encoding='utf-8') as warnings:
        for warning in map(str.strip, warnings):
            if not warning:
                continue
            saw_warning = True
            if not any(pattern.fullmatch(warning) for pattern in patterns):
                print(warning)
                unexpected = True

    if not saw_warning:
        print(f'{report}: no warnings to check', file=sys.stderr)
        return 1
    if unexpected:
        return 1
    report.unlink()
    return 0


if __name__ == '__main__':
    try:
        sys.exit(check_warnings())
    except (OSError, UnicodeError, re.error) as error:
        sys.exit(f'{sys.argv[0]}: {error}')
